# Server
# Port 3500 dipilih karena port 4000 sering konflik dengan Angular CLI & tools lain
PORT=3500
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (Vite dev servers)
# Example:
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Cookie
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Prisma / MySQL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:@localhost:3306/genbiunsika

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=genbiunsika

# Google Drive (Service Account)
# Recommended: share a Drive folder with the service account email.
GDRIVE_FOLDER_ID=1sKX6CjigdohbnxjfyA7xfSrxPiMn7t_i
# Option A: raw key (be careful with newlines on Windows)
GDRIVE_CLIENT_EMAIL=
GDRIVE_PRIVATE_KEY=
# Option B (recommended): base64-encoded JSON key
GDRIVE_SERVICE_ACCOUNT_KEY_BASE64=

# Optional (Google Workspace): Domain-Wide Delegation impersonation
# Use this if Shared Drives are unavailable/disabled.
# Requires enabling Domain-Wide Delegation for the service account in Google Cloud
# and granting Drive scope in Google Admin.
GDRIVE_IMPERSONATE_USER=

# Optional (no Workspace admin needed): OAuth end-user consent
# Use a regular Google account that has normal Drive quota.
# By default, the server will use GOOGLE_CLIENT_ID (first ID if comma-separated).
# If you want a separate OAuth client specifically for Drive, set GDRIVE_OAUTH_CLIENT_ID.
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=

# Seed (optional)
# Run with: npm run db:seed
SEED_ADMIN_EMAIL=admin@unsika.ac.id
SEED_ADMIN_PASSWORD=change_me

# Smoke test (optional)
SMOKE_EMAIL=
SMOKE_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL_SECONDS=21600
JWT_REFRESH_TTL_SECONDS=2592000

# Cookie SameSite policy for refresh token cookie.
# Use "lax" for same-site deployments (recommended).
# If frontend/backend are on different sites/domains and refresh cookie isn't sent, set "none" AND enable HTTPS (COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# Auth restrictions
AUTH_ALLOWED_EMAIL_DOMAIN=unsika.ac.id,student.unsika.ac.id
AUTH_REQUIRE_EMAIL_VERIFIED=true

# Google Sign-In
GOOGLE_CLIENT_ID=1015424406938-so5oeb8hicss9kad02s8i9kf20adhkvm.apps.googleusercontent.com

# Email verification (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Used to generate verification link
FRONTEND_CLIENT_BASE_URL=http://localhost:5173
